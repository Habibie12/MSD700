        <mxCell id="5zcwWd_T4yXpuO8_11xI-0" parent="hZsKiYdVrp9ALZoW2wGT-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;General System Overview&lt;/h1&gt;&lt;h3&gt;&lt;font face=&quot;Helvetica&quot;&gt;The MSD700 robot system can be divided into two main wiring groups:&lt;/font&gt;&lt;/h3&gt;" vertex="1">
