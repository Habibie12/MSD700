        </mxCell>
        <mxCell id="VzAw25nOq-CT2ZhzkMRU-9" parent="hZsKiYdVrp9ALZoW2wGT-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;align=center;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 22px; color: rgb(255, 51, 51);&quot;&gt;Attachment diagram block&lt;/font&gt;&lt;/h1&gt;" vertex="1">
          <mxGeometry height="36" width="307" x="773" y="168" as="geometry" />
        </mxCell>
        <mxCell id="VzAw25nOq-CT2ZhzkMRU-11" parent="hZsKiYdVrp9ALZoW2wGT-1" style="shape=note;size=20;whiteSpace=wrap;html=1;spacingLeft=9;spacingRight=12;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;The Base MSD700 wiring system is divided into two main&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;parts: &lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;external base components&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; and the &lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;internal combiner box system&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;External components include large devices located outside the combiner box, while the combiner box contains the core electrical components&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;This separation is used to simplify system understanding and wiring documentation&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="153" width="378" x="732" y="649" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
