        </mxCell>
        <mxCell id="BvtuYAnFbBbNWnL1dpQx-2" parent="1" style="shape=note;size=20;whiteSpace=wrap;html=1;align=center;spacingLeft=8;spacingRight=26;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;For the current Oriental Motor installation, the left and right motors appear reversed when viewed from the rear of the motor assembly.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;As a result, the motor referred to as the “right motor” is physically located on the left side, and vice versa, following the original manufacturer’s configuration&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="422" x="718" y="134" as="geometry" />
        </mxCell>
      </root>
