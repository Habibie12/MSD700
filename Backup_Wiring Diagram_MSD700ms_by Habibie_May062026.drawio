        <mxCell id="MnVaeccW4-DI_1-L2oVV-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;h1&gt;&lt;span class=&quot;a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none&quot; style=&quot;caret-color: rgb(255, 255, 255); --Ys-XuQ: none; font-kerning: none;&quot;&gt;&lt;font style=&quot;color: rgb(102, 51, 0);&quot;&gt;Wiring diagram of the charger module interface (220V Indonesia power Grid)&lt;/font&gt;&lt;/span&gt;&lt;/h1&gt;" vertex="1">
          <mxGeometry height="74" width="890" x="149" y="97" as="geometry" />
        </mxCell>
        <mxCell id="MnVaeccW4-DI_1-L2oVV-7" parent="1" style="shape=note;size=20;whiteSpace=wrap;html=1;spacingLeft=8;spacingRight=12;" value="&lt;div style=&quot;line-height: 100%;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;The charging system interface is designed to operate with the &lt;b&gt;Indonesian power grid at 220 V AC&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;An RCBO is installed to provide earth leakage and electrical shock protection, while an MCB is used as a circuit breaker to start and stop the charging process in accordance with the Delta-Q charger manual&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;The MCB also serves as overload protection for the charging circuit&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="166" width="341" x="24" y="557" as="geometry" />
        </mxCell>
